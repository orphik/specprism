{
  "name": "@specprism/mcp-server",
  "version": "1.6.0",
  "mcpName": "io.github.orphik/specprism",
  "description": "SpecPrism Stateless MCP 2026-07-28 Server — Multi Round-Trip Request (MRTR) Socratic elicitations, ext-skills, Streamable HTTP & stdio.",
  "license": "MIT",
  "homepage": "https://spec-prism.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orphik/specprism.git",
    "directory": "packages/mcp-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "specprism",
    "ears",
    "specification",
    "ai-agents"
  ],
  "type": "module",
  "main": "./dist/index.js",
